{
    "name": "kiiskominfokepri/esign-php",
    "description": "PHP Client Library for BSrE (Balai Sertifikasi Elektronik) Esign Client Service API v1 & v2",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "esign",
        "bsre",
        "bssn",
        "tanda-tangan-elektronik",
        "digital-signature"
    ],
    "authors": [
        {
            "name": "Doni Mustasar",
            "email": "donny.md17@gmail.com"
        }
    ],
    "require": {
        "php": "^7.2.5 || ^8.0",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "guzzlehttp/guzzle": "^7.8",
        "symfony/polyfill-php80": "^1.31"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.39 || ^9.6"
    },
    "autoload": {
        "psr-4": {
            "KiisKepri\\Esign\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KiisKepri\\Esign\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
